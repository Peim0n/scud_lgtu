# Рантайм-артефакты бэкенд-интеграции (сертификаты, персистентные события,
# локальный кэш доступа) — не должны попадать в репозиторий.
app/infrastructure/certs/
app/infrastructure/persistence/events.json
app/infrastructure/cache/local_access.json

# Диагностические скрипты ручной проверки backend (scripts/backend_check/):
# рабочие mTLS-сертификаты/ключи и сохранённые ответы бэкенда — секреты и
# рантайм-артефакты, не должны попадать в репозиторий.
scripts/backend_check/certs/

# Локальные тестовые ключи для generate_qr.py (симулятор системы выпуска
# QR-кодов для офлайн-тестирования считывателя). Само приложение (QRDecoder)
# ключи на диск не пишет и не читает — только в память через KeySyncService.
qr_test_keys/

